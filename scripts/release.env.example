# Copy to scripts/release.env (gitignored) and fill in, then `chmod 600 scripts/release.env`.
# Read by scripts/release.sh to skip the server/credential prompts. Anything
# already exported in your environment overrides what's set here.
#
# Plain shell assignments — the file is sourced, so quote values containing
# spaces or '#', and don't put a space around the '='.

# Base URL of the Streamio server to upload the build to. No trailing slash
# needed; include the path prefix if the install is mounted under one
# (e.g. https://example.com/streamio).
STREAMIO_SERVER_URL="https://streamio.example.com"

# Admin login used to set the client-version policy and upload the APK.
# The account must be in the server's ADMIN_EMAILS.
STREAMIO_ADMIN_EMAIL="you@example.com"
STREAMIO_ADMIN_PASSWORD="your-password"

# Optional: an already-issued admin access token. If set, the script uses it
# and skips the login entirely (email/password above are then ignored).
# Access tokens are short-lived, so this is mostly useful for CI.
#STREAMIO_ADMIN_TOKEN=""
